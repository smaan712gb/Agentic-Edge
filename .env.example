# ---------------------------------------------------------------------------
# Agentic Edge — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the keys you have. The system reads
# only what you give it: missing keys disable the corresponding agent or
# capability rather than crashing the service.
#
# NEVER commit your .env. The .gitignore in this repo excludes it by default.
# ---------------------------------------------------------------------------


# ---- LLM ------------------------------------------------------------------
# DeepSeek powers the agent reasoning. Other providers can be added later.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_QUICK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro


# ---- Market data + research vendors --------------------------------------
# Each vendor is independent. If you don't have a key, the agents that
# depend on it are skipped — runs still complete with a partial view.
POLYGON_API_KEY=
UNUSUAL_WHALES_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ---- SEC EDGAR (Hedge Fund Signal Tracker) -------------------------------
# SEC's fair-access policy requires a descriptive User-Agent with a contact
# email. No API key — the email below is sent as the UA. Leave blank to
# disable EDGAR polling (the manager tracker will sit idle). If you're behind
# a TLS-intercepting corporate proxy, also point SSL_CERT_FILE at your CA
# bundle so cert verification against data.sec.gov succeeds.
EDGAR_USER_AGENT_EMAIL=
EDGAR_POLL_ENABLED=true


# ---- Interactive Brokers (PAPER ONLY) ------------------------------------
# The system refuses to start with IBKR_MODE=live. To trade live you must
# change that explicitly in code; this is intentional.
#
# IBKR_PORT defaults: 4002 (Gateway paper), 7497 (TWS paper).
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=11
IBKR_MODE=paper


# ---- Admin + automation --------------------------------------------------
# Required to call any /api/admin/* endpoint (kill switch, scheduler,
# reconcile). The service rejects placeholder values like "changeme".
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Master autotrade gate. Even when "true", the kill switch in the UI and
# the gated 5-stage pipeline are still in force.
AUTOTRADE_ENABLED=false


# ---- Persistence + cache (optional) --------------------------------------
# SQLite is the default for development; uncomment to use Postgres.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_edge
# REDIS_URL=redis://localhost:6379/0
# PROVIDER_CACHE_DIR=/var/cache/agentic_edge
